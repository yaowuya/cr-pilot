# cr-pilot 环境变量模板
#
# 用法：复制为 .env 并填入真实值（.env 已 gitignore / .dockerignore，不入库不进镜像）。
# - 本机开发：npm start 启动时自动加载根目录 .env。
# - Docker 部署：docker-compose.yml 把 ./.env 挂载为容器内 /app/.env:ro，
#   应用在容器内同样自动加载，全部配置（含 pi 密钥）闭环在 .env 一个文件里。
#
# 无任何必填项：GitLab 访问令牌随 webhook 请求头 X-Gitlab-Token 携带，
# GitLab 实例地址从 X-Gitlab-Instance 头或 payload 派生。

# ---- pi 模型密钥（Docker 闭环必需）----
# 容器内 pi-agent/models.json 的 apiKey 用 $LLMGW_API_KEY 插值，密钥只从本文件注入。
# 本机开发时 pi 读取 ~/.pi/agent/auth.json，不依赖该变量。
LLMGW_API_KEY=

# ---- GitLab 相关 ----
# GitLab 访问令牌（可选，全局兜底；webhook 请求头 X-Gitlab-Token 优先按任务级注入）
GITLAB_TOKEN=

# GitLab 实例地址（可选，留空则从 webhook 请求头派生）
GITLAB_URL=https://code.cwoa.net

# 内网自签名证书时设为 1，跳过 TLS 校验
GITLAB_INSECURE_TLS=0

# GitLab API 单次请求超时（毫秒）
GITLAB_API_TIMEOUT=15000

# ---- 服务监听 ----
HOST=127.0.0.1
PORT=5001

# ---- 评审参数（均为默认值，按需覆盖）----
# 单批评审/汇总超时（毫秒），默认 20 分钟
REVIEW_TIMEOUT_MS=1200000

# 单批 token 预算（模型上下文 1M，默认 120000；按需调大调小）
REVIEW_BATCH_MAX_TOKENS=120000

# 规则目录（相对路径在容器内同样解析到 /app/prompts/rules）
REVIEW_RULES_DIR=prompts/rules

# 评审风格：professional / sarcastic / gentle / humorous
REVIEW_STYLE=professional

# 后台队列并发数
QUEUE_CONCURRENCY=5

# 兜底 prompt 路径
REVIEW_PROMPT_PATH=prompts/review.md

# 日志级别：debug / info / warn / error / silent
LOG_LEVEL=info

# 日志文件路径（可选）：非空时日志同时写入该文件（目录不存在会自动创建）。
# Docker 部署建议 LOG_FILE=/app/logs/cr-pilot.log，配合 docker-compose 的
# /data/logs/cr-pilot 挂载把日志落到宿主机。留空则只输出控制台。
LOG_FILE=

# ---- 持久化与管理控制台 ----

# SQLite 数据库文件路径。容器部署建议 /app/data/cr-pilot.db，配合
# docker-compose 的 /data/cr-pilot 挂载；目录不存在时会自动创建。
# 注意：WAL 模式不支持网络文件系统，该路径必须落在本地盘。
DB_PATH=./data/cr-pilot.db

# 首次启动引导创建的管理员账号（仅在管理员表为空时生效）。
# 创建后请通过管理页面维护账号，这里的值不再影响已有账号。
# 注意：ADMIN_PASSWORD 留空时不会创建账号（空密码无法登录），启动会告警。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 令牌与密码盐的部署盐（必填！留空服务拒绝启动）。
# 令牌由「用户名 + 此盐」离线派生：盐为空等于任何人都能算出管理令牌，
# 管理 API（配置、账号、评审记录）完全开放，因此启动时直接终止。
# 生成方式：node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SALT=
