# cr-pilot 环境变量模板
#
# 使用方法：复制为项目根目录的 .env（cp .env.example .env / copy .env.example .env），
# 启动时（npm start 或 node src/server.ts）会自动加载 .env；已存在的同名环境变量优先。
# .env 已被 .gitignore 排除，真实密钥不会入库；本模板可安全提交。

# ---- 必填（缺失时启动直接报错）----

# GitLab 实例地址，不带尾部斜杠
GITLAB_URL=https://code.cwoa.net

# GitLab 访问令牌：用于拉取 MR 变更（changes/commits）与回写评论（notes）。
# 需要具备目标项目 api 权限的 Personal/Project Access Token。
GITLAB_TOKEN=

# 注意：webhook 不校验 GITLAB_WEBHOOK_SECRET。一个 GitLab 实例可以有多个项目，
# 每个项目在 GitLab 侧配置的 Secret token 各不相同，单实例无法用一份全局 secret
# 校验所有来源，因此来源保护（内网隔离、网关白名单等）由部署层负责。

# ---- 可选（以下均为默认值）----

# 监听端口 / 地址
PORT=5001
HOST=127.0.0.1

# 评审 prompt 兜底文件（无 YAML 规则时使用）
REVIEW_PROMPT_PATH=prompts/review.md

# 单批评审/汇总的超时毫秒数
REVIEW_TIMEOUT_MS=120000

# 日志级别：debug / info / warn / error / silent
LOG_LEVEL=info

# 1 = 跳过 GitLab TLS 证书校验（内网自签名场景）。
# 注意：Node 无法对单个请求关闭校验，启用后还需设置 NODE_TLS_REJECT_UNAUTHORIZED=0
# 或配置 NODE_EXTRA_CA_CERTS 后重启进程；对 code.cwoa.net 证书可信，无需启用。
GITLAB_INSECURE_TLS=0

# GitLab API 单次请求超时毫秒数
GITLAB_API_TIMEOUT=15000

# 单批评审的 token 预算
REVIEW_BATCH_MAX_TOKENS=6000

# 仓库级规则目录（default.yaml 为全局默认；其余文件按 repository 字段匹配）
REVIEW_RULES_DIR=prompts/rules

# 评审风格：professional / sarcastic / gentle / humorous（注入规则模板的 {{ style }}）
REVIEW_STYLE=professional

# pi 模型凭证不通过环境变量配置，由 ~/.pi/agent/models.json 与 auth.json 管理，
# 详见 README「前置条件：pi 模型凭证」。
