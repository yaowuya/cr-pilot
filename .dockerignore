# 依赖与构建产物
node_modules/
npm-debug.log*
# 前端构建产物由 frontend 阶段在容器内重新生成；本地 dist 只会拖慢构建上下文。
# 注意不要排除 web/public/——favicon 等静态资源要从那里打进产物。
dist/

# pi 运行期产物：models.json / settings.json 由数据库配置生成，不该从仓库带入镜像，
# 镜像内首次启动时按 models.template.json 兜底后重新生成。
pi-agent/models.json
pi-agent/settings.json

# Git 与版本控制
.git/
.gitignore

# 本地环境变量（部署时用真实环境变量注入；.env 会挂载进容器）
.env
.env.*
!.env.example

# IDE / 编辑器
.idea/
.vscode/
*.swp
*.swo

# 测试与覆盖率
test/
coverage/

# 文档与历史（部署镜像不需要）
fp-docs/
README.md

# 技能与本地缓存
.agent/
.apifox/
.mcp.json

# 系统文件
.DS_Store
Thumbs.db
